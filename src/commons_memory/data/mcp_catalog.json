{
 "catalog_version": "2026.10.1",
 "schema": 1,
 "note": "Presets verified against each vendor's own docs on verified_on. Extend/override in ~/.commons/mcp_catalog.json ({\"presets\":{...}}). Mark anything you add unverified unless you checked vendor docs.",
 "presets": {
  "github": {
   "title": "GitHub (hosted)",
   "transport": "http",
   "url": "https://api.githubcopilot.com/mcp/",
   "auth": "oauth or token",
   "oauth": true,
   "docs": "https://github.com/github/github-mcp-server/blob/main/docs/remote-server.md",
   "verified": true,
   "verified_on": "2026-10-11",
   "secrets": [
    {
     "name": "GITHUB_PAT",
     "header": "Authorization",
     "format": "Bearer {ref}",
     "optional": false,
     "help": "token stored as a secret ref"
    }
   ],
   "risk": {
    "merge_pull_request": "destructive",
    "delete_*": "destructive",
    "create_*": "write",
    "update_*": "write",
    "push_*": "write"
   },
   "health": "tools/list"
  },
  "github-local": {
   "title": "GitHub (local Docker)",
   "transport": "stdio",
   "command": "docker",
   "args": [
    "run",
    "-i",
    "--rm",
    "-e",
    "GITHUB_PERSONAL_ACCESS_TOKEN",
    "ghcr.io/github/github-mcp-server"
   ],
   "auth": "token",
   "docs": "https://github.com/github/github-mcp-server",
   "verified": true,
   "verified_on": "2026-10-11",
   "secrets": [
    {
     "name": "GITHUB_PAT",
     "env": "GITHUB_PERSONAL_ACCESS_TOKEN"
    }
   ],
   "risk": {
    "merge_pull_request": "destructive",
    "delete_*": "destructive"
   },
   "health": "tools/list"
  },

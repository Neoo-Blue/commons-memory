# Copy to .env. Secret VALUES go in ./secrets/ files (docker secrets), not here:
#   mkdir -p secrets && openssl rand -base64 24 > secrets/dashboard_token && openssl rand -base64 24 > secrets/postgres_password
#   chmod 644 secrets/*   # the container user (uid 10001) must be able to read them; keep the directory private: chmod 700 secrets
COMMONS_VERSION=0.7.2
COMMONS_BIND=127.0.0.1            # 0.0.0.0 only behind a firewall/VPN; keys are always required
# COMMONS_DB=postgresql://commons:<postgres_password>@postgres/commons   # --profile postgres
COMMONS_PUBLIC_URL=               # e.g. https://commons.tailnet.ts.net (used in snippets/A2A card)
COMMONS_WEBHOOK_ALLOWLIST=        # hosts allowed for wake webhooks / A2A push
COMMONS_BACKGROUND=1
COMMONS_DRIVE_BACKEND=local       # s3|webdav|hostfs|sftp|smb|ftp (see docs/drive.md; credentials as *_REF secret refs)

# --profile tailscale
TS_AUTHKEY=                       # tskey-auth-... (prefer ephemeral + tagged)
TS_HOSTNAME=commons
# --profile cloudflared
CLOUDFLARE_TUNNEL_TOKEN=
# --profile ngrok
NGROK_AUTHTOKEN=
NGROK_FLAGS=                      # e.g. --oauth=google --oauth-allow-email=you@example.com

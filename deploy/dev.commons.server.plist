<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.commons.server</string>
  <key>ProgramArguments</key><array><string>/usr/local/bin/commons</string><string>serve</string><string>--transport</string><string>http</string><string>--host</string><string>127.0.0.1</string><string>--port</string><string>8765</string></array>
  <key>EnvironmentVariables</key><dict><key>COMMONS_DB</key><string>/Users/YOU/.commons/commons.db</string><key>COMMONS_REQUIRE_KEYS</key><string>1</string></dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/Users/YOU/.commons/server.log</string>
</dict></plist>
<!-- install: save as ~/Library/LaunchAgents/dev.commons.server.plist ; launchctl load -w that file -->
